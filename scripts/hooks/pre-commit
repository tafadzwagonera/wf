#!/bin/sh

# pre-commit hook: Run linting, enforce generated docs freshness, and warn about .wf/ files

# Run linting
echo "Running linting..."
npm run lint
LINT_EXIT_CODE=$?

if [ $LINT_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "ERROR: Linting failed. Fix errors before committing."
    echo ""
    exit 1
fi

# Regenerate generated docs/help artifacts and fail on drift
echo "Regenerating command docs and help artifacts..."
npm run generated-docs:sync
DOCS_SYNC_EXIT_CODE=$?

if [ $DOCS_SYNC_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "ERROR: Failed to regenerate command docs/help artifacts."
    echo ""
    exit 1
fi

git diff --exit-code -- README.md docs/commands-help.catalog.json > /dev/null 2>&1
DOCS_DIFF_EXIT_CODE=$?

if [ $DOCS_DIFF_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "ERROR: Generated command docs/help artifacts changed."
    echo "Run \`npm run generated-docs:sync\`, review the updates, stage them, and retry."
    echo ""
    git diff -- README.md docs/commands-help.catalog.json
    exit 1
fi

# Check for staged .wf/ files
STAGED_WF_FILES=$(git diff --cached --name-only | grep -E "^\.wf/" | head -20)

if [ -n "$STAGED_WF_FILES" ]; then
    echo ""
    echo "WARNING: You are about to commit files under .wf/ which should be gitignored."
    echo "  Staged .wf/ files:"
    echo "$STAGED_WF_FILES" | sed 's/^/    - /'
    echo ""
    echo "Consider running: git reset HEAD <file> to unstage them."
    echo ""
fi

exit 0
