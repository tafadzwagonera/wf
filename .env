# Platform Configuration
# Specify which platforms to enable (comma-separated: jira, github, bitbucket)
# If omitted, platforms are auto-detected based on configured credentials
# ENABLED_PLATFORMS=jira,github,bitbucket
# ENABLED_PLATFORMS=jira
PRIMARY_PLATFORM=jira
DEFAULT_OUTPUT_FORMAT=md

# AI Provider Configuration
# Select which LLM provider to use: anthropic (default), gemini, deepseek
AI_PROVIDER=gemini

# Anthropic — required when AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# Google Gemini — required when AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyBTQySxCVcei3bVGu4M_HJ8PlzpHlXanQo

# DeepSeek — required when AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-xxxxx

# Optional: override the default model for the selected provider
# Defaults: anthropic=claude-sonnet-4-20250514, gemini=gemini-2.5-pro, deepseek=deepseek-reasoner
AI_MODEL=gemini-2.5-pro

# Atlassian Configuration (Jira + Bitbucket)
ATLASSIAN_BASE_URL=https://touraxis.atlassian.net
ATLASSIAN_EMAIL=tafadzwa.gonera@touraxis.com

