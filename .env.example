# ─────────────────────────────────────────────
# AI Provider Configuration
# ─────────────────────────────────────────────
# Select the active LLM provider (anthropic | gemini | deepseek | openai)
AI_PROVIDER=anthropic

# Anthropic — required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI — required when AI_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-xxxxx

# Google Gemini — required when AI_PROVIDER=gemini
# GEMINI_API_KEY=AIzaxxxxx

# DeepSeek — required when AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-xxxxx

# Override the default model for the active provider.
# Defaults: anthropic=claude-sonnet-4-20250514, openai=gpt-4.1, gemini=gemini-2.5-pro, deepseek=deepseek-reasoner
# AI_MODEL=

# Maximum tokens for AI responses (default: 4096)
# AI_MAX_TOKENS=4096

# ─────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
LOG_DIRECTORY=.wf/logs

# ─────────────────────────────────────────────
# Atlassian Configuration (Jira + Bitbucket)
# ─────────────────────────────────────────────
ATLASSIAN_BASE_URL=https://yourcompany.atlassian.net
ATLASSIAN_EMAIL=your-email@company.com

# Jira
ATLASSIAN_JIRA_API_TOKEN=your-jira-api-token
# ATLASSIAN_JIRA_DEFAULT_PROJECT=

# Bitbucket
ATLASSIAN_BITBUCKET_API_TOKEN=your-bitbucket-api-token
ATLASSIAN_BITBUCKET_WORKSPACE=your-workspace

# ─────────────────────────────────────────────
# Branch Naming Configuration
# ─────────────────────────────────────────────
# ATLASSIAN_BRANCH_PATTERN=^(bugfix|build|chore|ci|docs|feat|feature|fix|perf|performance|refactor|revert|style|test)\/[A-Z]+-[0-9]+__|__.+$
# GITHUB_BRANCH_PATTERN=^(bugfix|build|chore|ci|docs|feat|feature|fix|perf|performance|refactor|revert|style|test)\/[A-Za-z0-9_-]+$
# BRANCH_PREFIX_IMPLEMENT=feature
# BRANCH_PREFIX_FIX=bugfix
# BRANCH_PREFIX_INVESTIGATE=chore

# ─────────────────────────────────────────────
# Git Configuration
# ─────────────────────────────────────────────
# Commit message format (conventional | freeform | auto)
GIT_COMMIT_FORMAT=auto
GIT_DEFAULT_BRANCH=develop

# ─────────────────────────────────────────────
# GitHub Configuration
# ─────────────────────────────────────────────
GITHUB_TOKEN=ghp_your-token
# GITHUB_DEFAULT_REPO=owner/repo

# ─────────────────────────────────────────────
# Platform Configuration
# ─────────────────────────────────────────────
# Which platform to treat as primary (jira | github | bitbucket)
PRIMARY_PLATFORM=jira

# Comma-separated list of platforms to enable.
# Omit to auto-detect from configured credentials.
# ENABLED_PLATFORMS=jira,github,bitbucket

# Default output format for generated tickets (md | json | yaml | xml)
DEFAULT_OUTPUT_FORMAT=md

# ─────────────────────────────────────────────
# Slack Configuration
# ─────────────────────────────────────────────
# Bot Token with scopes: channels:history, channels:read,
# groups:history, im:history, mpim:history
# Required to use Slack thread permalinks as sources in issue:generate
# SLACK_BOT_TOKEN=xoxb-xxxxx

# ─────────────────────────────────────────────
# Workflow & State Configuration
# ─────────────────────────────────────────────
WORKFLOW_DIRECTORY=.windsurf/workflows
STATE_DIRECTORY=.wf/state
