{
  "name": "wf",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "require": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./config": {
      "types": "./dist/config/public-config.d.ts",
      "require": "./dist/config/public-config.js",
      "default": "./dist/config/public-config.js"
    }
  },
  "bin": {
    "wf": "./dist/main.js"
  },
  "scripts": {
    "build": "nest build",
    "postbuild": "chmod +x dist/main.js && ts-node -r tsconfig-paths/register scripts/generate-help-catalog.ts",
    "help:catalog": "ts-node -r tsconfig-paths/register scripts/generate-help-catalog.ts",
    "docs:sync": "ts-node -r tsconfig-paths/register scripts/sync-issue-command-docs.ts",
    "docs:check": "ts-node -r tsconfig-paths/register scripts/sync-issue-command-docs.ts --check",
    "generated-docs:sync": "npm run help:catalog && npm run docs:sync",
    "generated-docs:check": "npm run generated-docs:sync && git diff --exit-code -- README.md docs/commands-help.catalog.json",
    "format:write": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "npm run format:write",
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:manual": "ts-node -r tsconfig-paths/register run-manual-test.ts",
    "issue:create": "yarn start issue-create",
    "issue:implement": "yarn start issue-implement",
    "issue:review": "yarn start issue-review"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.97",
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/generative-ai": "^0.24.1",
    "@hapi/joi": "^17.1.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@octokit/rest": "^18",
    "@openai/agents": "^0.8.3",
    "axios": "^1.13.6",
    "bitbucket": "^2.12.0",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dayjs": "^1.11.20",
    "fast-xml-parser": "^5.5.6",
    "inquirer": "^8.2.6",
    "marked": "^17.0.4",
    "nest-commander": "^3.20.1",
    "openai": "^6.32.0",
    "ora": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "simple-git": "^3.33.0",
    "yaml": "^2.8.2",
    "typescript": "^5.7.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^30.0.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
